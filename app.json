{
  "expo": {
    "name": "TimelineApp",
    "slug": "TimelineApp",
    "scheme": "timelineapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "backgroundColor": "#0f1024",
      "image": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sarahphillips.timelineapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Timeline uses the camera so you can take photos for your profile and events.",
        "NSPhotoLibraryUsageDescription": "Timeline uses your photos for your profile picture and pictures on events."
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.sarahphillips.timelineapp",
      "adaptiveIcon": {
        "backgroundColor": "#0f1024",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "text/plain",
            "message/rfc822",
            "image/*",
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Timeline uses your photos for your profile picture and pictures on events.",
          "cameraPermission": "Timeline uses the camera so you can take photos for your profile and events.",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "owner": "sarahpoet6014",
    "extra": {
      "eas": {
        "projectId": "0f4f935b-9897-4ac5-b760-39d00794adfc"
      }
    }
  }
}
