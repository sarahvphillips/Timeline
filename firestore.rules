rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isOwnerEmail() {
      return isSignedIn()
        && request.auth.token.email == 'sarah.v.phillips@googlemail.com';
    }
    function isListedAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/app/staff)
        && request.auth.token.email in get(/databases/$(database)/documents/app/staff).data.admins;
    }
    function isAdmin() {
      return isOwnerEmail() || isListedAdmin();
    }

    match /app/staff {
      // Admin list, gates, and the in-app audit. get()/exists() inside rules
      // still see this doc, so isListedAdmin() keeps working for everyone else.
      allow read: if isAdmin();
      allow write: if isOwnerEmail();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      function usageNumbersOk() {
        return request.resource.data.reads is number
          && request.resource.data.writes is number
          && request.resource.data.deletes is number
          && request.resource.data.reads >= 0
          && request.resource.data.writes >= 0
          && request.resource.data.deletes >= 0
          && request.resource.data.date is string;
      }
      function usageNotLowered() {
        return (
          request.resource.data.date == resource.data.date
          && request.resource.data.reads >= resource.data.get('reads', 0)
          && request.resource.data.writes >= resource.data.get('writes', 0)
          && request.resource.data.deletes >= resource.data.get('deletes', 0)
        ) || request.resource.data.date > resource.data.date;
      }
      function adsUnlockUnchanged() {
        return request.resource.data.get('adsUnlocked', 0) == resource.data.get('adsUnlocked', 0);
      }

      match /events/{eventId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /meta/usage {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && usageNumbersOk()
          && request.resource.data.get('adsUnlocked', 0) == 0;
        allow update: if isOwner(userId)
          && usageNumbersOk()
          && usageNotLowered()
          && adsUnlockUnchanged();
        allow delete: if false;
      }
      match /meta/botUsage {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
      match /meta/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if docId != 'usage' && docId != 'botUsage'
          && (isOwner(userId) || isAdmin());
      }
      match /entitlements/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
      match /wordNumbers/{entryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /settings/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.visibility == 'public';
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /profileHandles/{handle} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /sharedEvents/{id} {
      // Signed-in read so invitees can preview before accept (MVP).
      // Tighten later to creator/participant OR pending-invite holder.
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.createdByUid
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.createdByUid
            || request.auth.uid in resource.data.participantUids
            || (request.auth.uid in request.resource.data.participantUids
                && !(request.auth.uid in resource.data.participantUids)));
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.createdByUid;
    }

    match /sharedWordLists/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.createdByUid
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.createdByUid
            || request.auth.uid in resource.data.participantUids
            || (request.auth.uid in request.resource.data.participantUids
                && !(request.auth.uid in resource.data.participantUids)));
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.createdByUid;
    }

    match /eventInvites/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUid;
      // fromUid always; pending -> accepted by acceptedByUid;
      // pending -> declined by declinedByUid; accepted -> declined by acceptedByUid (leave cleanup)
      allow update: if isSignedIn()
        && (
          request.auth.uid == resource.data.fromUid
          || (
            resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedByUid == request.auth.uid
          )
          || (
            resource.data.status == 'pending'
            && request.resource.data.status == 'declined'
            && request.resource.data.declinedByUid == request.auth.uid
          )
          || (
            resource.data.status == 'accepted'
            && request.resource.data.status == 'declined'
            && resource.data.acceptedByUid == request.auth.uid
            && request.resource.data.declinedByUid == request.auth.uid
          )
        );
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.fromUid;
    }

    match /timelineShares/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.createdByUid
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if isSignedIn()
        && (
          request.auth.uid == resource.data.createdByUid
          || request.auth.uid in resource.data.participantUids
          || (
            request.auth.uid in request.resource.data.participantUids
            && !(request.auth.uid in resource.data.participantUids)
            && resource.data.participantUids.size() < 2
          )
        );
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.createdByUid;

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/timelineShares/$(id)).data.createdByUid == request.auth.uid;
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/timelineShares/$(id)).data.createdByUid == request.auth.uid;
      }
    }

    match /rewardsIndex/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /creditTransfers/{id} {
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 100;
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
      );
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed';
      allow delete: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
        || isAdmin()
      );
    }

    match /testerFeedback/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Bot keys and admin keys: doc id = SHA-256. Only the Cloud Function (Admin SDK) reads or writes them.
    match /botKeys/{keyHash} {
      allow read, write: if false;
    }

    match /adminKeys/{keyHash} {
      allow read, write: if false;
    }

    match /botRate/{keyHash} {
      allow read, write: if false;
    }

    match /config/usageRules {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 5000
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'title', 'detail', 'status', 'createdAt', 'updatedAt'
        ]);
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /adminLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.action is string
        && request.resource.data.at is string
        && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }

    match /joinInvites/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.type == 'join';
      allow update: if isSignedIn()
        && (
          request.auth.uid == resource.data.fromUid
          || (
            resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedByUid == request.auth.uid
          )
        );
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.fromUid;
    }
  }
}
